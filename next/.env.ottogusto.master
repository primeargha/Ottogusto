# Change store here

# STORE="ottogusto" # For server components
# NEXT_PUBLIC_STORE="ottogusto" # For client components
STORE=ottogusto  # For server components
NEXT_PUBLIC_STORE=ottogusto # For client components

# Telemetry configuration
NODE_ENV=production
NEXT_PUBLIC_ENABLE_TELEMETRY=false
NEXT_PUBLIC_TELEMETRY_STATIC=false

# Locale country/language lists (single source of truth for UI locale selection)
NEXT_PUBLIC_COUNTRIES={"nl":"Netherlands","be":"Belgium","fr":"France","lu":"Luxembourg"}
NEXT_PUBLIC_LANGUAGES={"nl":"Nederlands","en":"English","fr":"Français","de":"Deutsch","key":"Key"}
# JSON array: allowed URL locales (first path segment). Omit to use code defaults.
NEXT_PUBLIC_LANG_COUNTRY_COMBINATIONS=["en-BE","nl-BE","fr-BE","de-BE","key-BE", "en-NL","nl-NL","fr-NL","de-NL","key-NL", "en-FR","nl-FR","fr-FR","de-FR","key-FR", "en-LU","nl-LU","fr-LU","de-LU","key-LU"]

NEXT_PUBLIC_LOGO_URL=https://ottogusto.com/assets/ottogusto-logo.svg

# Feature flags (JSON): ops edit per deployment; no code change. Locale country from URL (e.g. en-BE → BE).
NEXT_PUBLIC_BRANDS_FILTER_FEATURE_FLAG={"default":false,"exception_countries":[]}
