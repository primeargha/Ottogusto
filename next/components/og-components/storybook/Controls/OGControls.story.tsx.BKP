// Interactive examples with OGButton
const InteractiveAlert = ({ variant, title, description }: { variant: 'info' | 'warning' | 'error'; title: string; description: string }) => {
  const [showAlert, setShowAlert] = useState(false);

  return (
    <div className="flex flex-col gap-4">
      <OGButton 
        type="primary" 
        onClick={() => setShowAlert(!showAlert)}
      >
        {showAlert ? 'Hide Alert' : `Show ${variant.charAt(0).toUpperCase() + variant.slice(1)} Alert`}
      </OGButton>
      {showAlert && (
        <OGAlert
          variant={variant}
          title={title}
          description={description}
        />
      )}
    </div>
  );
};

export const InteractiveInfo: Story = {
  args: {
