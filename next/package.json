{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next/cache && next dev",
    "local": "dotenv -e .env.local -- next dev",
    "build": "next build && node copyassets.js",
    "start": "next start -p 8080",
    "start_live": "PORT=8080 node .next/standalone/server.js",
    "lint": "next lint --dir app --dir components --dir screens --dir hooks --dir services --dir stores --dir helpers --dir utils --dir contexts --dir config --dir lib --dir providers --dir server --dir types --dir src",
    "lint:staged": "next lint --max-warnings 0 --dir app --dir components --dir screens --dir hooks --dir services --dir stores --dir helpers --dir utils --dir contexts --dir config --dir lib --dir providers --dir server --dir types --dir src",
    "lint:strict-local": "node scripts/lint-strict-local.js",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-local": "node scripts/typecheck-strict-local.js",
    "check:all": "npm run lint:strict-local && npm run typecheck:strict-local",
    "lint:architecture": "eslint . --ext .ts,.tsx --rule 'import/no-restricted-paths: error'",
    "check:dependencies": "madge --circular ./",
    "dpc": "depcruise --exclude \"^node_modules\" --output-type dot --collapse \"^(app|components|screens|services|stores|hooks|helpers)/[^/]+\" app components screens services stores hooks helpers | dot -T svg > dependencygraph.svg",
    "analyze:imports": "depcruise --validate .dependency-cruiser.js .",
    "analyze:imports:svg": "depcruise --validate --output-type dot .dependency-cruiser.js | dot -T svg > dependency-graph.svg",
    "test:architecture": "vitest run tests/architecture/",
    "check:architecture": "node scripts/check-architecture.js",
    "postinstall": "patch-package",
    "format": "prettier --write .",
    "format:staged": "prettier --write",
    "storybook": "node copyassets.js && storybook dev -p 6006",
    "build-storybook": "node copyassets.js && storybook build",
    "prepare": "cd .. && husky next/.husky"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.6.0",
    "@axiomhq/js": "^1.7.0",
    "@axiomhq/logging": "^0.2.2",
    "@axiomhq/nextjs": "^0.2.2",
    "@axiomhq/react": "^0.2.2",
    "@expo/html-elements": "0.4.2",
    "@gluestack-ui/accordion": "^1.0.4",
    "@gluestack-ui/actionsheet": "^0.2.44",
    "@gluestack-ui/alert": "^0.1.14",
    "@gluestack-ui/alert-dialog": "^0.1.28",
    "@gluestack-ui/avatar": "^0.1.17",
    "@gluestack-ui/button": "^1.0.4",
    "@gluestack-ui/checkbox": "^0.1.28",
    "@gluestack-ui/divider": "^0.1.8",
    "@gluestack-ui/fab": "^0.1.20",
    "@gluestack-ui/form-control": "^0.1.17",
    "@gluestack-ui/icon": "^0.1.21",
    "@gluestack-ui/image": "^0.1.9",
    "@gluestack-ui/input": "^0.1.29",
    "@gluestack-ui/link": "^0.1.20",
    "@gluestack-ui/menu": "^0.2.33",
    "@gluestack-ui/modal": "^0.1.32",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@gluestack-ui/overlay": "latest",
    "@gluestack-ui/popover": "^0.1.34",
    "@gluestack-ui/pressable": "^0.1.16",
    "@gluestack-ui/progress": "^0.1.14",
    "@gluestack-ui/radio": "^0.1.29",
    "@gluestack-ui/select": "^0.1.29",
    "@gluestack-ui/slider": "^0.1.23",
    "@gluestack-ui/spinner": "^0.1.14",
    "@gluestack-ui/switch": "^0.1.21",
    "@gluestack-ui/textarea": "^0.1.21",
    "@gluestack-ui/toast": "^1.0.4",
    "@gluestack-ui/tooltip": "^0.1.30",
    "@gluestack/ui-next-adapter": "latest",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@legendapp/motion": "^2.4.0",
    "@next/third-parties": "^16.1.6",
    "@react-native/assets-registry": "^0.82.1",
    "@sentry/nextjs": "^10.38.0",
    "@tanstack/query-sync-storage-persister": "^5.74.4",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-query-persist-client": "^5.74.4",
    "@unitools/image": "^0.0.4",
    "@unitools/image-next": "^0.0.6",
    "@unitools/link": "^0.0.3",
    "@unitools/link-next": "^0.0.1",
    "@unitools/navigation": "^0.0.1-alpha.0",
    "@unitools/router": "^0.0.4",
    "@unitools/router-next": "^0.0.1",
    "autoprefixer": "latest",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.6.0",
    "browser-image-compression": "^2.0.2",
    "embla-carousel": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "expo-image": "^1.12.9",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.29.0",
    "gluestack-ui": "^3.0.11",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.13.0",
    "lucide-react-native": "^0.378.0",
    "meriyah": "^6.1.4",
    "moment": "^2.30.1",
    "nativewind": "4.0.36",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-native": "^0.84.1",
    "react-native-reanimated": "latest",
    "react-native-svg": "^15.2.0",
    "react-native-svg-web": "^1.0.0",
    "react-native-web": "^0.21.0",
    "react-phone-number-input": "^3.4.12",
    "react-range-slider-input": "^3.2.1",
    "react-responsive-masonry": "^2.7.1",
    "react-use": "^17.6.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "sonner": "^2.0.1",
    "tailwind-scrollbar": "^4.0.0",
    "tailwindcss": "3.4.3",
    "ua-parser-js": "^2.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-vitest": "^9.1.3",
    "@storybook/nextjs-vite": "^9.1.3",
    "@storybook/react-native-web-vite": "^9.1.3",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^7.2.4",
    "babel-plugin-react-native-web": "^0.19.10",
    "dependency-cruiser": "^17.3.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "eslint-plugin-storybook": "^9.1.3",
    "husky": "^9.1.7",
    "jscodeshift": "0.15.2",
    "madge": "^8.0.0",
    "playwright": "^1.54.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "storybook": "^9.1.10",
    "tailwind-plugin-ripple-effect": "^0.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "next lint --max-warnings 0 --dir app --dir components --dir screens --dir hooks --dir services --dir stores --dir helpers --dir utils --dir contexts --dir config --dir lib --dir providers --dir server --dir types --dir src"
    ],
    "*.{json,md,css,scss}": [
      "npx prettier --write"
    ]
  },
  "packageManager": "yarn@4.6.0"
}
